<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>오늘의 날씨</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }
    body {
      background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 50%, #06b6d4 100%);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
      color: #ffffff;
    }
    .weather-card {
      background: rgba(255, 255, 255, 0.18);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-radius: 24px;
      padding: 32px 28px;
      width: 100%;
      max-width: 380px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
      border: 1px solid rgba(255, 255, 255, 0.3);
      text-align: center;
    }
    .search-box {
      display: flex;
      gap: 8px;
      margin-bottom: 24px;
    }
    .search-box input {
      flex: 1;
      padding: 12px 16px;
      border-radius: 12px;
      border: none;
      outline: none;
      background: rgba(255, 255, 255, 0.85);
      font-size: 14px;
      color: #1f2937;
    }
    .search-box input::placeholder {
      color: #9ca3af;
    }
    .search-box button {
      padding: 12px 16px;
      border-radius: 12px;
      border: none;
      background: #1e40af;
      color: #ffffff;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s;
    }
    .search-box button:hover {
      background: #1e3a8a;
    }
    .location {
      font-size: 1.6rem;
      font-weight: 700;
      margin-bottom: 4px;
    }
    .date {
      font-size: 0.88rem;
      opacity: 0.85;
      margin-bottom: 20px;
    }
    .weather-icon {
      font-size: 4.5rem;
      margin: 10px 0;
      line-height: 1;
    }
    .temp {
      font-size: 3.8rem;
      font-weight: 800;
      margin-bottom: 6px;
      letter-spacing: -2px;
    }
    .condition {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 24px;
    }
    .details {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      background: rgba(0, 0, 0, 0.12);
      padding: 16px;
      border-radius: 16px;
    }
    .detail-item {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .detail-item .label {
      font-size: 0.75rem;
      opacity: 0.8;
      margin-bottom: 4px;
    }
    .detail-item .val {
      font-size: 0.95rem;
      font-weight: 600;
    }
    .loading {
      font-size: 1rem;
      padding: 40px 0;
      opacity: 0.9;
    }
    .error {
      color: #fecaca;
      font-size: 0.9rem;
      padding: 20px 0;
    }
  </style>
</head>
<body>

<div class="weather-card">
  <div class="search-box">
    <input type="text" id="cityInput" placeholder="도시명 입력 (예: 서울, 부산)" onkeydown="if(event.key==='Enter') searchWeather()">
    <button onclick="searchWeather()">검색</button>
  </div>

  <div id="weatherContent">
    <div class="loading">위치 정보 확인 중...</div>
  </div>
</div>

<script>
  const weatherCodes = {
    0: { desc: '맑음', icon: '☀️' },
    1: { desc: '대체로 맑음', icon: '🌤️' },
    2: { desc: '구름 조금', icon: '⛅' },
    3: { desc: '흐림', icon: '☁️' },
    45: { desc: '안개', icon: '🌫️' },
    48: { desc: '짙은 안개', icon: '🌫️' },
    51: { desc: '약한 이슬비', icon: '🌦️' },
    53: { desc: '이슬비', icon: '🌦️' },
    55: { desc: '강한 이슬비', icon: '🌦️' },
    61: { desc: '약한 비', icon: '🌧️' },
    63: { desc: '비', icon: '🌧️' },
    65: { desc: '강한 비', icon: '🌧️' },
    71: { desc: '약한 눈', icon: '🌨️' },
    73: { desc: '눈', icon: '❄️' },
    75: { desc: '강한 눈', icon: '❄️' },
    80: { desc: '약한 소나기', icon: '🌧️' },
    81: { desc: '소나기', icon: '🌧️' },
    82: { desc: '강한 소나기', icon: '⛈️' },
    95: { desc: '뇌우', icon: '🌩️' }
  };

  function getWeatherInfo(code) {
    return weatherCodes[code] || { desc: '정보 없음', icon: '🌡️' };
  }

  function formatDate() {
    const today = new Date();
    return today.toLocaleDateString('ko-KR', {
      month: 'long',
      day: 'numeric',
      weekday: 'short'
    });
  }

  async function fetchWeatherByCoords(lat, lon, cityName = '현재 위치') {
    const contentDiv = document.getElementById('weatherContent');
    contentDiv.innerHTML = `<div class="loading">날씨 데이터 불러오는 중...</div>`;

    try {
      const response = await fetch(
        `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m&daily=temperature_2m_max,temperature_2m_min,precipitation_probability_max&timezone=auto`
      );
      const data = await response.json();

      const current = data.current;
      const daily = data.daily;
      const weather = getWeatherInfo(current.weather_code);

      contentDiv.innerHTML = `
        <div class="location">${cityName}</div>
        <div class="date">${formatDate()}</div>
        <div class="weather-icon">${weather.icon}</div>
        <div class="temp">${Math.round(current.temperature_2m)}°C</div>
        <div class="condition">${weather.desc}</div>
        <div class="details">
          <div class="detail-item">
            <span class="label">최고 / 최저</span>
            <span class="val">${Math.round(daily.temperature_2m_max[0])}° / ${Math.round(daily.temperature_2m_min[0])}°</span>
          </div>
          <div class="detail-item">
            <span class="label">습도</span>
            <span class="val">${current.relative_humidity_2m}%</span>
          </div>
          <div class="detail-item">
            <span class="label">강수확률</span>
            <span class="val">${daily.precipitation_probability_max[0]}%</span>
          </div>
        </div>
      `;
    } catch (err) {
      contentDiv.innerHTML = `<div class="error">날씨 정보를 가져올 수 없습니다.</div>`;
    }
  }

  async function searchWeather() {
    const input = document.getElementById('cityInput');
    const city = input.value.trim();
    if (!city) return;

    try {
      const res = await fetch(`https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(city)}&count=1&language=ko&format=json`);
      const data = await res.json();

      if (data.results && data.results.length > 0) {
        const place = data.results[0];
        fetchWeatherByCoords(place.latitude, place.longitude, place.name);
      } else {
        alert('검색한 도시를 찾을 수 없습니다.');
      }
    } catch (err) {
      alert('도시 검색 중 오류가 발생했습니다.');
    }
  }

  // 브라우저 위치 권한 확인 후 위치 기반 날씨 호출 (거부 시 서울 기준 기본 설정)
  if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition(
      (pos) => fetchWeatherByCoords(pos.coords.latitude, pos.coords.longitude, '현재 위치'),
      () => fetchWeatherByCoords(37.5665, 126.9780, '서울')
    );
  } else {
    fetchWeatherByCoords(37.5665, 126.9780, '서울');
  }
</script>

</body>
</html>
